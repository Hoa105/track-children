DATABASE_URL=postgresql://track_children:track_children_dev@localhost:5434/track_children_ai
BACKEND_API_URL=http://localhost:8000
# Chuỗi bí mật dùng chung với backend (AI_SERVICE_TOKEN bên backend)
INTERNAL_TOKEN=
# AI xem video: gemini (mặc định) | claude. Khung hình video được gửi tới nhà cung cấp này.
LLM_PROVIDER=gemini
# Gemini API — tạo khóa ở https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash,gemini-3.5-flash-lite
# Claude API (khi LLM_PROVIDER=claude)
ANTHROPIC_API_KEY=
# Model: claude-opus-5-5 (mặc định) | claude-sonnet-5-5 | claude-haiku-5-5 (rẻ nhất)
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium
LLM_MAX_FRAMES=16
VIDEO_DIR=./data/videos
# Giai đoạn 2 — chạy scripts/download_models.py trước
POSE_ENABLED=true
POSE_MODEL_PATH=./models/pose_landmarker_full.task
HAND_MODEL_PATH=./models/hand_landmarker.task
