{
  "openapi": "3.1.0",
  "info": {
    "title": "Track Children - Mobile Teething API",
    "version": "1.0.0",
    "description": "Hợp đồng API cho tab Răng của bé. Mã răng dùng hệ FDI cho 20 răng sữa."
  },
  "servers": [{"url": "http://localhost:8000"}],
  "tags": [{"name": "mobile: teething", "description": "Theo dõi mọc răng sữa của trẻ"}],
  "paths": {
    "/api/v1/children/{childId}/teeth": {
      "get": {
        "tags": ["mobile: teething"],
        "summary": "Danh sách răng đã mọc",
        "operationId": "getChildTeeth",
        "security": [{"bearerAuth": []}],
        "parameters": [{"$ref": "#/components/parameters/ChildId"}],
        "responses": {
          "200": {
            "description": "Danh sách hiện tại, có thể rỗng",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ToothRecords"}, "example": {"records": [{"toothCode": "71", "eruptedOn": "2026-08-12"}]}}}
          },
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "404": {"$ref": "#/components/responses/ChildNotFound"}
        }
      }
    },
    "/api/v1/children/{childId}/teeth/{toothCode}": {
      "parameters": [
        {"$ref": "#/components/parameters/ChildId"},
        {"$ref": "#/components/parameters/ToothCode"}
      ],
      "put": {
        "tags": ["mobile: teething"],
        "summary": "Ghi nhận hoặc cập nhật ngày mọc",
        "operationId": "upsertChildTooth",
        "security": [{"bearerAuth": []}],
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ToothUpsert"}, "example": {"eruptedOn": "2026-08-12", "timezoneOffsetMinutes": 420}}}
        },
        "responses": {
          "200": {"description": "Bản ghi đã lưu", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ToothRecord"}}}},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/ReadOnly"},
          "404": {"$ref": "#/components/responses/ChildNotFound"},
          "422": {"$ref": "#/components/responses/InvalidTooth"}
        }
      },
      "delete": {
        "tags": ["mobile: teething"],
        "summary": "Bỏ đánh dấu răng đã mọc",
        "operationId": "deleteChildTooth",
        "security": [{"bearerAuth": []}],
        "responses": {
          "204": {"description": "Đã xóa hoặc bản ghi vốn không tồn tại"},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/ReadOnly"},
          "404": {"$ref": "#/components/responses/ChildNotFound"}
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {"type": "http", "scheme": "bearer", "bearerFormat": "JWT"}
    },
    "parameters": {
      "ChildId": {"name": "childId", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}},
      "ToothCode": {"name": "toothCode", "in": "path", "required": true, "description": "Mã FDI răng sữa: góc phần tư 5-8, vị trí 1-5", "schema": {"type": "string", "pattern": "^[5-8][1-5]$", "example": "71"}}
    },
    "schemas": {
      "ToothRecord": {
        "type": "object",
        "required": ["toothCode", "eruptedOn"],
        "properties": {
          "toothCode": {"type": "string", "pattern": "^[5-8][1-5]$", "example": "71"},
          "eruptedOn": {"type": "string", "format": "date", "example": "2026-08-12"}
        }
      },
      "ToothRecords": {
        "type": "object",
        "required": ["records"],
        "properties": {"records": {"type": "array", "maxItems": 20, "items": {"$ref": "#/components/schemas/ToothRecord"}}}
      },
      "ToothUpsert": {
        "type": "object",
        "additionalProperties": false,
        "required": ["eruptedOn", "timezoneOffsetMinutes"],
        "properties": {
          "eruptedOn": {"type": "string", "format": "date", "description": "Từ ngày sinh đến ngày hiện tại theo giờ thiết bị"},
          "timezoneOffsetMinutes": {"type": "integer", "minimum": -720, "maximum": 840, "description": "Độ lệch UTC hiện tại từ hệ thống người dùng; Việt Nam là 420", "example": 420}
        }
      },
      "Error": {
        "type": "object",
        "properties": {"detail": {"type": "string"}}
      }
    },
    "responses": {
      "Unauthorized": {"description": "Thiếu hoặc hết hạn phiên đăng nhập"},
      "ReadOnly": {"description": "Thành viên chỉ có quyền xem", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
      "ChildNotFound": {"description": "Không tìm thấy trẻ hoặc không có quyền xem", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
      "InvalidTooth": {"description": "Mã răng hoặc ngày mọc không hợp lệ", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}
    }
  },
  "x-screen-operations": {
    "Răng của bé / mở màn hình": "getChildTeeth",
    "Ghi nhận / Lưu": "upsertChildTooth",
    "Chưa mọc / Lưu": "deleteChildTooth"
  }
}
