{
  "openapi": "3.1.0",
  "info": {
    "title": "Track Children - Mobile Auth API",
    "version": "2.0.0",
    "description": "# Đăng ký App với schema 009\n\nCập nhật 23/10/2026. Tài liệu này thay thế phần đăng ký/OTP/phiên trong hợp đồng auth cũ.\nLuồng đăng nhập bằng mật khẩu và web admin sẽ được đồng bộ trong hạng mục tiếp theo."
  },
  "servers": [
    {
      "url": "http://localhost:8000/api/v1",
      "description": "Local backend"
    }
  ],
  "tags": [
    {
      "name": "Mobile Auth"
    }
  ],
  "paths": {
    "/legal-documents": {
      "get": {
        "operationId": "get_legal_documents",
        "tags": [
          "Mobile Auth"
        ],
        "summary": "Lấy điều khoản đăng ký",
        "description": "Schema 009. See docs/api/mobile-registration-v2.md for behavior and deployment configuration.",
        "security": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LegalDocumentsResult"
                }
              }
            }
          },
          "503": {
            "description": "DATABASE_UNAVAILABLE; LEGAL_DOCUMENTS_UNAVAILABLE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "VALIDATION_ERROR",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "context",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "registration"
              ]
            }
          }
        ]
      }
    },
    "/auth/register": {
      "post": {
        "operationId": "post_auth_register",
        "tags": [
          "Mobile Auth"
        ],
        "summary": "Đăng ký",
        "description": "Schema 009. See docs/api/mobile-registration-v2.md for behavior and deployment configuration.",
        "security": [],
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegistrationChallenge"
                }
              }
            },
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "no-store"
                  ]
                }
              }
            }
          },
          "409": {
            "description": "ACCOUNT_CONFLICT; LEGAL_CONSENT_REQUIRED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "RATE_LIMITED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait",
                "schema": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          },
          "503": {
            "description": "DATABASE_UNAVAILABLE; AUTH_NOT_CONFIGURED; LEGAL_DOCUMENTS_UNAVAILABLE; OTP_DELIVERY_UNAVAILABLE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "VALIDATION_ERROR",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          }
        }
      }
    },
    "/auth/register/verify": {
