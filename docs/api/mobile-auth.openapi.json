          "Mobile Auth"
        ],
        "summary": "Làm mới phiên",
        "description": "Schema 009. See docs/api/mobile-registration-v2.md for behavior and deployment configuration.",
        "security": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResult"
                }
              }
            },
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "no-store"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "REFRESH_TOKEN_INVALID; SESSION_EXPIRED; SESSION_REVOKED; REFRESH_TOKEN_REUSED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "ACCOUNT_UNAVAILABLE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "VALIDATION_ERROR",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "DATABASE_UNAVAILABLE; AUTH_NOT_CONFIGURED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequest"
              }
            }
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "operationId": "post_auth_logout",
        "tags": [
          "Mobile Auth"
        ],
        "summary": "Đăng xuất",
        "description": "Schema 009. See docs/api/mobile-registration-v2.md for behavior and deployment configuration.",
        "security": [],
        "responses": {
          "204": {
            "description": "No content; idempotent logout."
          },
          "422": {
            "description": "VALIDATION_ERROR",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "DATABASE_UNAVAILABLE; AUTH_NOT_CONFIGURED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LogoutRequest"
              }
            }
          }
        }
      }
    },
    "/auth/me": {
      "get": {
        "operationId": "get_auth_me",
        "tags": [
          "Mobile Auth"
        ],
        "summary": "Lấy người dùng hiện tại",
        "description": "Schema 009. See docs/api/mobile-registration-v2.md for behavior and deployment configuration.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "401": {
            "description": "ACCESS_TOKEN_INVALID; ACCESS_TOKEN_EXPIRED; SESSION_EXPIRED; SESSION_REVOKED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "WWW-Authenticate": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "Bearer"
                  ]
                }
              }
            }
          },
          "403": {
            "description": "ACCOUNT_UNAVAILABLE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "DATABASE_UNAVAILABLE; AUTH_NOT_CONFIGURED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/auth/social": {
      "post": {
        "operationId": "social_register",
        "tags": [
          "Mobile Auth"
        ],
        "description": "Google/Apple verified sign-in. See docs/api/mobile-social-auth.md. No automatic email linking.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SocialRegisterRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "App session and isNewUser",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResult"
                }
              }
            }
          },
          "401": {
            "description": "SOCIAL_TOKEN_INVALID"
          },
          "403": {
            "description": "Unverified email or unavailable account"
          },
          "409": {
            "description": "SOCIAL_ACCOUNT_CONFLICT"
          },
          "503": {
            "description": "Provider not configured or unavailable"
          }
        }
      }
    },
    "/auth/social/apple/challenge": {
      "post": {
        "operationId": "apple_social_challenge",
        "tags": [
          "Mobile Auth"
        ],
        "responses": {
          "200": {
            "description": "Ten-minute signed challenge and nonce"
          },
          "503": {
            "description": "SOCIAL_AUTH_NOT_CONFIGURED"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "required": [
          "id",
          "email",
          "phone",
          "fullName",
          "relationship",
          "status",
          "emailVerifiedAt",
          "phoneVerifiedAt",
          "displayName",
          "defaultRelationship"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": [
              "string",
              "null"
            ],
            "format": "email",
            "maxLength": 254
          },
          "phone": {
            "type": [
              "string",
              "null"
            ]
          },
          "fullName": {
            "type": "string"
          },
          "relationship": {
            "type": "string",
            "enum": [
              "mother",
              "father",
              "grandfather",
              "grandmother",
              "other_guardian"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "active"
            ]
          },
          "emailVerifiedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "phoneVerifiedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "defaultRelationship": {
            "type": "string",
            "enum": [
              "mother",
              "father",
              "grandfather",
              "grandmother",
              "other_guardian"
            ]
          },
          "displayName": {
            "type": "string"
          }
        }
      },
      "Device": {
        "additionalProperties": false,
        "properties": {
          "deviceId": {
            "anyOf": [
              {
                "maxLength": 100,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Deviceid"
          },
          "deviceName": {
            "anyOf": [
              {
                "maxLength": 100,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Devicename"
          },
          "platform": {
            "enum": [
              "android",
              "ios",
              "web"
            ],
            "title": "Platform",
            "type": "string"
          }
        },
        "required": [
          "platform"
        ],
        "title": "Device",
        "type": "object"
      },
      "AuthResult": {
        "type": "object",
        "required": [
          "tokenType",
          "accessToken",
          "expiresIn",
          "refreshToken",
          "sessionExpiresAt",
          "user"
        ],
        "properties": {
          "tokenType": {
            "type": "string",
            "enum": [
              "Bearer"
            ]
          },
          "accessToken": {
            "type": "string"
          },
          "expiresIn": {
            "type": "integer",
            "minimum": 1
          },
          "refreshToken": {
            "type": "string"
          },
          "sessionExpiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "user": {
            "$ref": "#/components/schemas/User"
          },
          "deletionRequestCancelled": {
            "type": "boolean"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message",
              "fields",
              "details"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "fields": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "details": {
                "type": "object",
                "additionalProperties": true,
                "properties": {
                  "registration": {
                    "$ref": "#/components/schemas/RegistrationChallenge"
                  },
                  "attemptsRemaining": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 5
                  }
                }
              }
            }
          }
        }
      },
      "LegalDocumentsResult": {
        "type": "object",
        "required": [
          "documents"
        ],
        "properties": {
          "documents": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "docType",
                "version",
                "content",
                "isRequired",
                "effectiveAt"
              ],
              "properties": {
                "docType": {
                  "type": "string",
                  "enum": [
                    "terms",
                    "privacy",
                    "data_policy"
                  ]
                },
                "version": {
                  "type": "string"
                },
                "content": {
                  "type": "string"
                },
                "isRequired": {
                  "type": "boolean"
                },
                "effectiveAt": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          }
        }
      },
      "RegisterRequest": {
        "additionalProperties": false,
        "properties": {
          "displayName": {
            "default": "Phụ huynh",
            "maxLength": 150,
            "title": "Displayname",
            "type": "string"
          },
          "email": {
            "anyOf": [
              {
                "format": "email",
                "maxLength": 254,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Email"
          },
          "phone": {
            "anyOf": [
              {
                "type": "string"
              },
