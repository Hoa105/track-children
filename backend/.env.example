APP_NAME=Track Children API
DATABASE_URL=postgresql://track_children:track_children_dev@localhost:5433/track_children
AUTH_SECRET=
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
APP_ENV=production
AUTH_SKIP_OTP=false
# Chỉ dùng khi phát triển: nhận người dùng qua header X-User-Id và admin qua
# X-Admin-Role thay cho token (chưa có đăng nhập thật). Production phải để false.
DEV_AUTH=true
CORS_ORIGINS=["http://localhost:5173"]
# ai-service: nhận xét AI cho video nhật ký (AI_SERVICE_TOKEN = INTERNAL_TOKEN bên ai-service)
AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_TOKEN=
AI_VIDEO_MAX_MB=150
# MinIO: ảnh / video nhật ký. MINIO_PUBLIC_URL trống = host mobile gọi backend + MINIO_PUBLIC_PORT
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=track_children
MINIO_SECRET_KEY=track_children_dev
MINIO_BUCKET=diary-media
MINIO_SECURE=false
MINIO_PUBLIC_URL=
MINIO_PUBLIC_PORT=9000
MEDIA_URL_TTL_MINUTES=60
DIARY_IMAGE_MAX_MB=15
DIARY_VIDEO_MAX_MB=150
