APP_NAME=Track Children API
DATABASE_URL=postgresql://track_children:track_children_dev@localhost:5433/track_children
AUTH_SECRET=
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_TOKEN=
EMAIL_PROVIDER=smtp2go
SMTP2GO_API_KEY=
SMTP2GO_SENDER_EMAIL=
SMTP2GO_SENDER_NAME=Track Children
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Track Children
# JSON containing reviewed terms, privacy and data_policy; required for registration.
LEGAL_DOCUMENTS_PATH=
APP_ENV=production
AUTH_SKIP_OTP=false
# Optional shared local file for login throttling (default: backend/.runtime/auth-rate-limits.sqlite3).
# All API workers on one host must use the same writable file.
AUTH_RATE_LIMIT_PATH=
# Local-only: display an OTP preview without sending email/SMS. Never enable in production.
AUTH_OTP_PREVIEW=false
GOOGLE_CLIENT_IDS=[]
APPLE_CLIENT_IDS=[]
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=
APPLE_REDIRECT_URI=
APPLE_ANDROID_PACKAGE=com.example.track_children
AUTH_ADMIN_AUDIENCE=track-children-admin
# Local profile helper only; all protected APIs require Bearer JWT.
DEV_AUTH=false
CORS_ORIGINS=["http://localhost:5173"]
